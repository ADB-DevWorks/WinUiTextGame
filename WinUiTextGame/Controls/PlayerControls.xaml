<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUiTextGame.Controls.PlayerControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUiTextGame.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Brown" Height="100" ColumnSpacing="8">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="25*" />
            
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Button x:Name="ButtonOne"
                Grid.Column="0" 
                Grid.Row="0" 
                Background="Black"
                Content="North" 
                Foreground="White"
                Visibility="Visible"
                FontSize="12"
                HorizontalContentAlignment="Stretch"
                Margin="15"
                ></Button>
        <Button x:Name="ButtonTwo"
                Grid.Column="1" 
                Grid.Row="0" 
                Background="Black"
                Content="East"
                ></Button>

        <Button x:Name="ButtonThree"
        Grid.Column="2" 
        Grid.Row="0" 
        Background="Black"
        Content="South"
        ></Button>

        <Button x:Name="ButtonFour"
        Grid.Column="3" 
        Grid.Row="0" 
        Background="Black"
        Content="West"
        ></Button>

        <TextBox x:Name="ControlInput" 
                 AutomationProperties.Name="multi-line TextBox"
                 TextWrapping="Wrap" 
                 AcceptsReturn="True"
                 IsSpellCheckEnabled="True" 
                 MinWidth="400"
                 Background="Black"
                 Grid.Row="1" 
                 Grid.Column="1" 
                 Grid.ColumnSpan="2"
                 Margin="5"
                 PlaceholderText="Enter an action"
                 />
        <Button x:Name="Submit"
                Grid.Column="3"
                Grid.Row="1"               
                Background="Black"
                Content="Perform Action"
                />
    </Grid>
</UserControl>
